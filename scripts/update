#!/usr/bin/env bash
# Update the locally installed ai-sandboxes checkout to origin/main and refresh
# what it drives: the locally built images, the fish wrappers (only for users
# who opted in via scripts/install-fish-functions), and — when present — msb.
# --check is read-only and suitable for a schedule; the default mode
# fast-forwards, rebuilds, and reloads.
set -o pipefail
IFS=$'\n\t'

name=$(basename "$0")

die() {
  printf '%s: %s\n' "$name" "$*" >&2
  exit 2
}

usage() {
  cat >&2 <<EOF
usage: $name [--check] [--verify] [--repair]
  --check   report whether an update is available (exit 0 = current, 1 = behind)
  --verify  run the full ./scripts/verify after updating (default: light checks)
  --repair  force full reinstall regardless of marker or changed paths
EOF
  exit 64
}

cd "$(dirname "$0")/.." || die 'could not cd to repository root'

# shellcheck disable=SC1091 # Resolved after cd to the repository root.
. ./scripts/lib/config-dir.sh

check_mode=0
verify_full=0
repair_mode=0
while test "$#" -gt 0; do
  case "$1" in
    --check) check_mode=1 ;;
    --verify) verify_full=1 ;;
    --repair) repair_mode=1 ;;
    *) usage ;;
  esac
  shift
done
if test "$check_mode" = 1 && test "$verify_full" = 1; then
  usage
fi
if test "$check_mode" = 1 && test "$repair_mode" = 1; then
  usage
fi

git config --get remote.origin.url >/dev/null 2>&1 \
  || die 'no git remote "origin"; cannot determine upstream'
test "$(git symbolic-ref --short HEAD 2>/dev/null)" = main \
  || die 'not on branch main; the updater only manages the installed main checkout'
test -z "$(git status --porcelain 2>/dev/null)" \
  || die 'working tree is dirty; commit or stash before updating'

git fetch origin main --quiet || die 'could not fetch origin/main'
old_head=$(git rev-parse HEAD) || die 'could not resolve HEAD'
new_head=$(git rev-parse origin/main) || die 'could not resolve origin/main after fetch'

# Reconciliation marker: the SHA of the last commit for which a full update
# completed successfully (binary + build + fish wrappers when the user opted
# into them). If a prior
# run fast-forwarded the tree but died before installing (e.g. install-ai-sandbox
# failed), the marker still points at the pre-merge SHA, so the next run can
# redo the pending work even though git already reports "up to date".
state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/ai-sandboxes"
marker_file="$state_dir/installed-head"
installed_head=''
if test -r "$marker_file"; then
  installed_head=$(cat "$marker_file" 2>/dev/null || :)
fi
# The marker file lives under $HOME and is only written by this script, but
# any process running as the user can tamper with it. Reject anything that
# is not a plain hex object name before it reaches git — otherwise a value
# like `--upload-pack=...` would be interpreted as a git flag, not a ref.
if ! [[ $installed_head =~ ^[0-9a-fA-F]{7,64}$ ]]; then
  installed_head=''
fi
# Only trust the marker if it points at a commit git still knows about; a
# marker from a discarded branch would otherwise poison every future run.
# --end-of-options belt-and-braces against future edits: even a validated
# hex string that happens to start with `-` (impossible today, but the
# check is cheap) is treated as a positional argument.
if test -n "$installed_head" \
  && ! git rev-parse --verify --quiet --end-of-options "$installed_head^{commit}" \
      >/dev/null 2>&1; then
  installed_head=''
fi

# Configuration reconciliation marker: a deterministic digest over the
# user-owned configuration files (marketplaces/tools/runtime) as of the last
# completed install or update. The images are built FROM these files, so a
# digest mismatch means the artifacts no longer match what the user runs —
# regardless of what git says. Read-only on purpose: --check must never
# create or seed configuration, so an absent or incomplete configuration
# directory counts as drifted state and is repaired by the build step.
recorded_config_digest=''
config_marker="$state_dir/installed-config-sha256"
if test -r "$config_marker"; then
  recorded_config_digest=$(cat "$config_marker" 2>/dev/null || :)
fi
if ! [[ $recorded_config_digest =~ ^[0-9a-fA-F]{64}$ ]]; then
  recorded_config_digest=''
fi
current_config_digest=''
if config_dir=$(_ai_sandboxes_locate_config_dir "$name") \
  && ai_sandboxes_config_files_present "$config_dir"; then
  current_config_digest=$(ai_sandboxes_config_digest "$config_dir") || die "could not compute the configuration digest for $config_dir"
fi
config_drift=0
if test "$current_config_digest" != "$recorded_config_digest"; then
  config_drift=1
fi

if test "$old_head" = "$new_head"; then
  if test "$repair_mode" = 1; then
    printf 'repairing: forcing full reinstall at %s\n' "${new_head:0:7}"
  elif test -z "$installed_head"; then
    if test "$check_mode" = 1; then
      printf 'marker missing: install state unknown at %s\n' "${new_head:0:7}"
      exit 1
    fi
    printf 'marker missing: reconciling install state at %s\n' "${new_head:0:7}"
  elif test "$installed_head" = "$new_head"; then
    if test "$config_drift" = 1; then
      # Git is current, but the configuration the images were built from no
      # longer matches what is on disk: rebuild and reload.
      if test "$check_mode" = 1; then
        printf 'configuration changed since last installation (%s)\n' "${new_head:0:7}"
        exit 1
      fi
      printf 'configuration changed since last installation; reconciling\n'
    else
      printf 'up to date\n'
      exit 0
    fi
  else
    # Git is up to date, but the last successful install lags behind HEAD.
    # --check reports that as a pending install (exit 1); the default mode
    # falls through and reconciles from the marker.
    if test "$check_mode" = 1; then
      printf 'install incomplete: last completed %s, HEAD at %s\n' \
        "${installed_head:0:7}" "${new_head:0:7}"
      exit 1
    fi
    printf 'up to date with origin/main; reconciling incomplete install (last completed %s)\n' \
      "${installed_head:0:7}"
  fi
elif ! git merge-base --is-ancestor "$old_head" "$new_head"; then
  die 'history diverged from origin/main; cannot fast-forward (rebase or start from a fresh clone)'
fi

tmpdir=$(mktemp -d) || die 'could not create a temporary directory'
trap 'rm -rf -- "$tmpdir"' EXIT
old_env="$tmpdir/old.env"
new_env="$tmpdir/new.env"

read_value() {
  local file=$1 key=$2 value='' line
  while IFS= read -r line; do
    [[ "$line" == "$key="* ]] && value=${line#"$key="}
  done <"$file"
  printf '%s\n' "$value"
}

# The reconciliation marker's invariant — "SHA at which the on-disk install
# was last known reconciled" — is only preserved if this is the single place
# the file is mutated. Callers pass either $diff_from (pin the baseline
# before install steps run) or $new_head (advance after every step
# succeeded); never any other value.
record_installed_head() {
  local sha=$1 tmp
  mkdir -p "$state_dir" \
    || die "could not create state directory $state_dir"
  tmp=$(mktemp "$marker_file.XXXXXX") \
    || die "could not create temporary marker file"
  printf '%s\n' "$sha" >"$tmp" \
    || { rm -f "$tmp"; die "could not write temporary marker file"; }
  mv -f "$tmp" "$marker_file" \
    || { rm -f "$tmp"; die "could not update reconciliation marker $marker_file"; }
}

# Same atomic-write discipline as record_installed_head, for the
# configuration digest marker. Callers pass a digest computed after every
# install step has succeeded; never any other value.
record_config_digest() {
  local digest=$1 tmp
  mkdir -p "$state_dir" \
    || die "could not create state directory $state_dir"
  tmp=$(mktemp "$config_marker.XXXXXX") \
    || die "could not create temporary marker file"
  printf '%s\n' "$digest" >"$tmp" \
    || { rm -f "$tmp"; die "could not write temporary marker file"; }
  mv -f "$tmp" "$config_marker" \
    || { rm -f "$tmp"; die "could not update reconciliation marker $config_marker"; }
}

version_change_summary() {
  git show HEAD:versions.env >"$old_env" 2>/dev/null || : >"$old_env"
  git show origin/main:versions.env >"$new_env" 2>/dev/null || : >"$new_env"
  if test -s "$old_env" && test -s "$new_env" \
    && ./.github/workflows/release-marker changed "$old_env" "$new_env" >/dev/null 2>&1; then
    printf 'version change: Codex %s -> %s, Claude Code %s -> %s' \
      "$(read_value "$old_env" CODEX_VERSION)" "$(read_value "$new_env" CODEX_VERSION)" \
      "$(read_value "$old_env" CLAUDE_CODE_VERSION)" "$(read_value "$new_env" CLAUDE_CODE_VERSION)"
  fi
}

light_verify() {
  if ! command -v docker >/dev/null 2>&1; then
    printf 'WARNING: docker not found; skipping light verification\n' >&2
    return 0
  fi
  set -a
  # shellcheck disable=SC1091
  . ./versions.env
  set +a
  local claude_v codex_v
  claude_v=$(docker run --rm --user node -e HOME=/home/node ai-sandboxes-claude:local \
    bash -lc 'test "$DISABLE_UPDATES" = 1; claude --version' 2>/dev/null) || true
  test "${claude_v%% *}" = "$CLAUDE_CODE_VERSION" \
    || printf 'WARNING: built Claude Code is %s, expected %s\n' "${claude_v%% *}" "$CLAUDE_CODE_VERSION" >&2
  codex_v=$(docker run --rm --user node -e HOME=/home/node ai-sandboxes-codex:local \
    codex --version 2>/dev/null) || true
  test "$codex_v" = "$CODEX_VERSION" \
    || printf 'WARNING: built Codex is %s, expected %s\n' "$codex_v" "$CODEX_VERSION" >&2
}

commits_behind=0
if test "$old_head" != "$new_head"; then
  commits_behind=$(git rev-list --count "$old_head..$new_head")
  printf 'update available: %s commits behind origin/main' "$commits_behind"
  summary=$(version_change_summary)
  if test -n "$summary"; then printf '; %s' "$summary"; fi
  printf '\n'
fi
if test "$check_mode" = 1; then
  if test "$old_head" = "$new_head"; then
    exit 0
  fi
  exit 1
fi

# Fish wrappers are opt-in: they are refreshed only for users who ran
# scripts/install-fish-functions at least once (marker below), or whose
# wrappers demonstrably came from that installer (legacy installs from before
# markers existed). A file merely existing at claude.fish proves nothing
# about ownership — a Fish user may have their own native Claude wrapper and
# silently overwriting shell startup code is exactly where an installer must
# be paranoid — so legacy detection requires the generator's unmistakable
# signature: wrappers we generate source the trusted guard from its installed
# location and call its __ai_sandbox_trusted_refuse_overlap check. Anything
# else is left untouched; rerunning scripts/install-fish-functions migrates
# it to marker-based management explicitly.
fish_marker="$state_dir/fish-wrappers-head"
fish_managed=0
if test -s "$fish_marker"; then
  fish_managed=1
else
  legacy_wrapper="$HOME/.config/fish/functions/claude.fish"
  if test -f "$legacy_wrapper" \
    && grep -qF '__ai_sandbox_trusted_refuse_overlap' "$legacy_wrapper" 2>/dev/null \
    && grep -qF '.config/ai-sandboxes/trusted/guard.fish' "$legacy_wrapper" 2>/dev/null; then
    fish_managed=1
  fi
fi

if test "$old_head" != "$new_head"; then
  printf 'updating %s -> %s\n' "$old_head" "$new_head"
  git merge --ff-only origin/main \
    || die 'git merge --ff-only origin/main failed; inspect the output above'
fi

# Determine whether we must run every install step regardless of diff.
force_all=0
if test "$repair_mode" = 1 || test -z "$installed_head"; then
  force_all=1
fi

# Determine the diff base for pending work. If a marker exists it is
# authoritative — it may reach further back than old_head when a prior run
# fast-forwarded but did not complete installation.
diff_from=${installed_head:-$old_head}

# Pin the pre-install baseline on disk before running any install step. If a
# subsequent install fails and this script dies, the marker keeps pointing at
# diff_from so the next run recomputes the same pending work — even after
# HEAD has already been fast-forwarded and git reports "up to date".
# Skip this write when force_all is set and the tree is already at HEAD:
# writing HEAD would make a failed install look complete on the next run.
if test "$force_all" = 0 || test "$old_head" != "$new_head"; then
  record_installed_head "$diff_from"
fi

if test "$force_all" = 1; then
  changed_paths=''
elif test "$diff_from" = "$new_head"; then
  changed_paths=''
else
  changed_paths=$(git diff --name-only --end-of-options "$diff_from" "$new_head")
fi

need_build=0
need_install=0
need_binary=0
while IFS= read -r p; do
  case "$p" in
    scripts/install-fish-functions|shell/*) need_install=1 ;;
    scripts/install-ai-sandbox) need_binary=1 ;;
    cmd/*|internal/*|go.mod|go.sum) need_binary=1 ;;
    scripts/update) : ;;
    versions.env|.dockerignore|docker-bake.hcl|images/*|config/*|scripts/*) need_build=1 ;;
  esac
done <<<"$changed_paths"

if test "$force_all" = 1; then
  need_build=1
  need_binary=1
  if test "$fish_managed" = 1; then
    need_install=1
  fi
fi

# Configuration drift alone forces a rebuild (and the msb reload plus
# verification that follow a build), but never reinstalls the Go binary or
# the fish wrappers: those track source changes and binary layout, not user
# configuration.
if test "$config_drift" = 1; then
  need_build=1
fi

if test "$need_binary" = 1; then
  printf 'reinstalling ai-sandbox binary...\n'
  ./scripts/install-ai-sandbox || die 'ai-sandbox binary install failed after updating'
  # A newly installed binary path may need re-baking into the wrappers if
  # they were generated by an older installer without the absolute path.
  need_install=1
fi

if test "$need_build" = 1; then
  printf 'rebuilding images...\n'
  ./scripts/build || die './scripts/build failed after updating; re-run scripts/update to retry'
fi

if test "$need_install" = 1; then
  if test "$fish_managed" = 0; then
    printf 'fish wrappers not installed (opt in with ./scripts/install-fish-functions); skipping wrapper refresh\n'
    need_install=0
  else
    printf 'reinstalling fish wrappers...\n'
    ./scripts/install-fish-functions || die 'fish wrapper install failed after updating'
  fi
fi

loaded=0
if test "$need_build" = 1 && command -v msb >/dev/null 2>&1; then
  printf 'reloading msb images...\n'
  ./scripts/load-msb || die 'msb image reload failed after updating'
  loaded=1
fi

if test "$need_build" = 1; then
  if test "$verify_full" = 1; then
    printf 'running full verification...\n'
    ./scripts/verify || die './scripts/verify failed after updating'
  else
    light_verify
  fi
fi

# All install steps succeeded — advance the marker to the current HEAD so a
# later run sees no pending reconciliation work.
record_installed_head "$new_head"

# And record the configuration the images were actually built from: mirror
# the build step by resolving, seeding any missing file from the checked-in
# neutral defaults, and hashing the result.
config_dir=$(ai_sandboxes_resolve_config_dir "$name") \
  || die 'could not resolve the ai-sandboxes configuration directory'
ai_sandboxes_init_config_files "$name" "$PWD" "$config_dir"
final_config_digest=$(ai_sandboxes_config_digest "$config_dir") \
  || die "could not compute the configuration digest for $config_dir"
record_config_digest "$final_config_digest"
record_config_digest "$final_config_digest"

if test "$old_head" = "$new_head"; then
  if test "$repair_mode" = 1; then
    status="repaired install at ${new_head:0:7}"
  else
    status="reconciled install to ${new_head:0:7}"
  fi
else
  status="fast-forwarded $commits_behind commits to ${new_head:0:7}"
fi
if test "$need_binary" = 1; then status="$status, reinstalled ai-sandbox binary"; fi
if test "$need_build" = 1; then status="$status, rebuilt docker images"; fi
if test "$need_install" = 1; then status="$status, reinstalled fish wrappers"; fi
if test "$loaded" = 1; then status="$status, loaded images into msb"; fi
printf 'done: %s\n' "$status"
exit 0