#!/usr/bin/env bash
# One-command installation: preflight the host, build and install the
# ai-sandbox control plane, build the images, load them into Microsandbox,
# and verify everything. Each step delegates to its individual script
# unchanged; those remain available for maintainers who need to run or re-run
# a single stage. The Fish wrappers are deliberately not installed here (they
# are host-shell-specific); run scripts/install-fish-functions separately if
# you use fish — the updater refreshes them only after that first opt-in.
set -o pipefail
IFS=$'\n\t'

name=$(basename "$0")

die() {
  printf '%s: %s\n' "$name" "$*" >&2
  exit 1
}

repo_root=$(cd "$(dirname "$0")/.." && pwd) || die 'could not resolve repository root'
cd "$repo_root" || die "could not cd to $repo_root"

# shellcheck disable=SC1091 # Resolved relative to the repository root above.
. "$repo_root/scripts/lib/config-dir.sh"

step() {
  local script=$1 description=$2 status
  printf '==> %s (%s)\n' "$script" "$description"
  "./scripts/$script" && return
  status=$?
  printf '%s: %s failed; fix the problem and re-run ./scripts/install or scripts/%s directly\n' \
    "$name" "$script" "$script" >&2
  exit "$status"
}

# Preflight every host dependency before mutating anything: a missing tool is
# a one-line diagnosis here instead of a failure discovered after the binary
# was replaced, every image was built, and the verification suite ran.
preflight() {
  local tool
  for tool in git go docker msb; do
    command -v "$tool" >/dev/null 2>&1 || die "prerequisite '$tool' not found; install it before running ./scripts/install"
  done
  docker info >/dev/null 2>&1 || die 'docker daemon is not reachable; start Docker and re-run ./scripts/install'
  docker buildx version >/dev/null 2>&1 || die 'docker buildx plugin not found; scripts/build requires it'
  case "$(uname -m)" in
    arm64 | aarch64) ;;
    *) die "unsupported architecture '$(uname -m)': images are built for arm64" ;;
  esac
  # A dirty tree would make the reconciliation marker a lie: it names HEAD,
  # but the artifacts were built from edits never committed to it. Untracked
  # files count too: they ride along in the checkout's Docker build context
  # and can change what COPY picks up. Refuse both, mirroring scripts/update,
  # so "marker == HEAD" always means "built from a clean HEAD".
  git rev-parse --is-inside-work-tree >/dev/null 2>&1 \
    || die 'not inside a git worktree; ./scripts/install only manages a git clone'
  git rev-parse --quiet --verify HEAD >/dev/null 2>&1 \
    || die 'could not resolve HEAD; this repository has no commits'
  test -z "$(git status --porcelain)" \
    || die 'working tree is not clean (uncommitted or untracked files); commit, stash, or clean before running ./scripts/install'
  # Resolve and seed the user-owned configuration directory before anything
  # is built: the images copy marketplaces/tools/runtime from there, so a
  # problem with configuration ownership or permissions should surface as a
  # one-line diagnosis up front. Seeding copies only the checked-in neutral
  # defaults for missing files and never touches existing user content.
  config_dir=$(ai_sandboxes_resolve_config_dir "$name") || exit $?
  ai_sandboxes_init_config_files "$name" "$repo_root" "$config_dir"
  printf 'configuration directory: %s\n' "$config_dir"
  # Baseline for the end-of-run comparison: scripts/build guards its own
  # build window, so a mismatch at record time means an edit landed outside
  # any guarded window. Fail rather than record a digest that does not
  # describe the images.
  config_digest_before=$(ai_sandboxes_config_digest "$config_dir") \
    || die "could not compute the configuration digest for $config_dir"
}

state_dir() {
  printf '%s\n' "${XDG_STATE_HOME:-$HOME/.local/state}/ai-sandboxes"
}

# Invalidate any previous reconciliation markers before the first mutating
# step. Both are written again only after every step succeeded, so if this
# run dies mid-way the stale files must not keep claiming that the old
# installation is still current: update --check must then report unknown
# install state and reconcile, never "up to date".
invalidate_prior_state() {
  local state
  state=$(state_dir)
  mkdir -p "$state" || die "could not create state directory $state"
  rm -f "$state/installed-head" \
    || die "could not remove stale reconciliation marker $state/installed-head; refusing to reinstall on top of unknown prior state"
  rm -f "$state/installed-config-sha256" \
    || die "could not remove stale configuration marker $state/installed-config-sha256; refusing to reinstall on top of unknown prior state"
}

# Record both reconciliation markers after every step succeeded: the HEAD at
# which the on-disk install is reconciled and the digest of the user
# configuration the images were built from. update --check compares against
# both to decide whether reconciliation work is pending.
record_state() {
  local sha state marker config_digest config_marker
  state=$(state_dir)
  mkdir -p "$state" || die "could not create state directory $state"

  write_marker() {
    local file=$1 value=$2 t
    t=$(mktemp "$file.XXXXXX") || die 'could not create temporary marker file'
    printf '%s\n' "$value" >"$t" || { rm -f "$t"; die 'could not write temporary marker file'; }
    mv -f "$t" "$file" || { rm -f "$t"; die "could not update reconciliation marker $file"; }
  }

  # Same reconciliation markers scripts/update maintains: written only after
  # every step succeeded, so update --check never mistakes this installation
  # for incomplete state and force-reinstalls (including the fish wrappers
  # the user declined).
  if sha=$(git rev-parse HEAD 2>/dev/null); then
    marker="$state/installed-head"
    write_marker "$marker" "$sha"
  fi
  # The digest is mandatory: silently skipping it would leave update --check
  # to fail closed on unknown state even though this install succeeded.
  config_digest=$(ai_sandboxes_config_digest "$config_dir") \
    || die "could not compute the configuration digest for $config_dir"
  test "$config_digest" = "$config_digest_before" \
    || die 'the configuration changed while installing; re-run ./scripts/install so the recorded digest matches the built artifacts'
  config_marker="$state/installed-config-sha256"
  write_marker "$config_marker" "$config_digest"
}

preflight || exit $?

invalidate_prior_state

step install-ai-sandbox 'build and install the ai-sandbox binary'
step build 'build base/tools/claude/codex/opencode docker images'
# load-msb runs before verify so exactly one component imports each image per
# lifecycle: verify's Microsandbox smoke tests consume the loaded images.
step load-msb 'load the images into Microsandbox'
step verify 'verify the control plane and images'

record_state

printf 'installed ai-sandboxes at revision %s\n' "$(git rev-parse --short HEAD 2>/dev/null || echo unknown)"
printf 'fish user? run ./scripts/install-fish-functions to install the claude/codex/opencode/claude-session wrappers\n'
