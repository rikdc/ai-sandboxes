#!/usr/bin/env bash
set -euo pipefail

repo_root=$(cd "$(dirname "$0")/.." && pwd)

fish_functions_dir="$HOME/.config/fish/functions"
trusted_dir="$HOME/.config/ai-sandboxes/trusted"

mkdir -p "$fish_functions_dir" "$trusted_dir"

# Copy (never symlink) the trust boundary and the wrappers below out of the
# checkout: a symlink would resolve back into the (possibly agent-mounted and
# therefore guest-writable) checkout at read time, defeating the point of
# installing them outside it. Re-run this script after updating ai-sandboxes
# to refresh the installed copies.
install -m 0644 "$repo_root/shell/fish/trusted/guard.fish" "$trusted_dir/guard.fish"

write_wrapper() {
  local agent=$1 impl_function=$2 impl_file=$3 out_file=$4
  cat >"$out_file" <<EOF
# Installed by ai-sandboxes' scripts/install-fish-functions. This wrapper is a
# copy, not a symlink, and lives outside the ai-sandboxes checkout on purpose:
# it is the trust boundary that runs before any checkout-provided code, so a
# guest agent with write access to a mounted ai-sandboxes checkout cannot
# tamper with it. Re-run scripts/install-fish-functions after updating
# ai-sandboxes to refresh it.
function $agent --description 'ai-sandboxes: $agent (installed wrapper)'
    source '$trusted_dir/guard.fish'
    __ai_sandbox_trusted_refuse_overlap $agent '$repo_root' '$fish_functions_dir' '$trusted_dir'; or return \$status
    source '$repo_root/shell/fish/lib/ai-sandbox.fish'
    source '$impl_file'
    $impl_function \$argv
end
EOF
}

write_wrapper claude __ai_sandbox_impl_claude "$repo_root/shell/fish/claude.fish" "$fish_functions_dir/claude.fish"
write_wrapper codex __ai_sandbox_impl_codex "$repo_root/shell/fish/codex.fish" "$fish_functions_dir/codex.fish"
write_wrapper claude-session __ai_sandbox_impl_claude_session "$repo_root/shell/fish/claude-session.fish" "$fish_functions_dir/claude-session.fish"

printf 'Installed ai-sandboxes Fish wrappers into %s (checkout: %s)\n' "$fish_functions_dir" "$repo_root"
