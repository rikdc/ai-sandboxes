#!/usr/bin/env bash
set -o pipefail

die() {
  printf 'install-fish-functions: %s\n' "$*" >&2
  exit 1
}

repo_root=$(cd "$(dirname "$0")/.." && pwd) || exit 1

fish_functions_dir="$HOME/.config/fish/functions"
trusted_dir="$HOME/.config/ai-sandboxes/trusted"
# ai-sandbox is installed by scripts/install-ai-sandbox to a directory outside
# any workspace a guest agent could mount. The wrapper invokes it by absolute
# path, and the guard refuses workspaces that overlap this directory, so a
# guest cannot drop an attacker-controlled binary in front of the next call.
ai_sandbox_install_dir="${AI_SANDBOX_INSTALL_DIR:-$HOME/.local/libexec/ai-sandboxes}"
ai_sandbox_bin="$ai_sandbox_install_dir/ai-sandbox"

mkdir -p "$fish_functions_dir" "$trusted_dir" "$ai_sandbox_install_dir" \
  || die 'could not create installation directories'

# Copy (never symlink) the trust boundary and the wrappers below out of the
# checkout: a symlink would resolve back into the (possibly agent-mounted and
# therefore guest-writable) checkout at read time, defeating the point of
# installing them outside it. Re-run this script after updating ai-sandboxes
# to refresh the installed copies.
install -m 0644 "$repo_root/shell/fish/trusted/guard.fish" "$trusted_dir/guard.fish" \
  || die 'could not install the trust-boundary guard'

# Fish single-quoted strings only treat \' and \\ specially; every other
# character, including a literal newline, is taken verbatim. Escape both
# before wrapping in quotes so a path containing an apostrophe (a real
# possibility in a $HOME directory name) can't break out of the generated
# wrapper's fish syntax.
fish_quote() {
  local s=$1
  s=${s//\\/\\\\}
  s=${s//\'/\\\'}
  printf "'%s'" "$s"
}

# claude, codex, and claude-session are single-command pass-throughs: after
# the guard check, everything hands off to `ai-sandbox run`, which resolves the
# plan (including, for claude-session, the --profile image), validates the
# workspace, and execs the Microsandbox. Anything fish-specific (egress args,
# shared-state handoff, workspace hashing) now lives in Go, so the wrappers
# stay minimal and never source checkout code.
write_pass_through_wrapper() {
  local agent=$1 out_file=$2
  local q_guard q_repo_root q_fish_functions_dir q_trusted_dir q_ai_sandbox_install_dir q_ai_sandbox_bin
  q_guard=$(fish_quote "$trusted_dir/guard.fish") || return 1
  q_repo_root=$(fish_quote "$repo_root") || return 1
  q_fish_functions_dir=$(fish_quote "$fish_functions_dir") || return 1
  q_trusted_dir=$(fish_quote "$trusted_dir") || return 1
  q_ai_sandbox_install_dir=$(fish_quote "$ai_sandbox_install_dir") || return 1
  q_ai_sandbox_bin=$(fish_quote "$ai_sandbox_bin") || return 1

  cat > "$out_file" <<EOF
function $agent --description '$agent: ai-sandboxes hardened Microsandbox launcher'
    source $q_guard
    __ai_sandbox_trusted_refuse_overlap $agent $q_repo_root $q_fish_functions_dir $q_trusted_dir $q_ai_sandbox_install_dir; or return \$status
    command $q_ai_sandbox_bin run $agent -- \$argv
end
EOF
}

# claude-session differs from the other two wrappers only in that its args are
# the agent's own (--profile first, then claude arguments): the profile flag
# must reach ai-sandbox, so no `--` is inserted before $argv.
write_claude_session_wrapper() {
  local out_file=$1
  local q_guard q_repo_root q_fish_functions_dir q_trusted_dir q_ai_sandbox_install_dir q_ai_sandbox_bin
  q_guard=$(fish_quote "$trusted_dir/guard.fish") || return 1
  q_repo_root=$(fish_quote "$repo_root") || return 1
  q_fish_functions_dir=$(fish_quote "$fish_functions_dir") || return 1
  q_trusted_dir=$(fish_quote "$trusted_dir") || return 1
  q_ai_sandbox_install_dir=$(fish_quote "$ai_sandbox_install_dir") || return 1
  q_ai_sandbox_bin=$(fish_quote "$ai_sandbox_bin") || return 1

  cat > "$out_file" <<EOF
function claude-session --description 'claude-session: ai-sandboxes hardened Microsandbox launcher'
    source $q_guard
    __ai_sandbox_trusted_refuse_overlap claude-session $q_repo_root $q_fish_functions_dir $q_trusted_dir $q_ai_sandbox_install_dir; or return \$status
    command $q_ai_sandbox_bin run claude \$argv
end
EOF
}

write_pass_through_wrapper claude "$fish_functions_dir/claude.fish" \
  || die 'could not write the claude wrapper'
write_pass_through_wrapper codex "$fish_functions_dir/codex.fish" \
  || die 'could not write the codex wrapper'
write_claude_session_wrapper "$fish_functions_dir/claude-session.fish" \
  || die 'could not write the claude-session wrapper'

printf 'Installed ai-sandboxes Fish wrappers into %s (checkout: %s)\n' "$fish_functions_dir" "$repo_root"
