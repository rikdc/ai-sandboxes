#!/usr/bin/env bash
# Build and install the ai-sandbox binary to a host-trusted location outside
# any workspace an agent could mount. The Fish wrappers invoke this binary by
# absolute path, and its directory is one of the protected roots the guard
# refuses workspaces to overlap with. Re-run after any change to cmd/**,
# internal/**, go.mod, go.sum, or this script itself.
set -o pipefail
IFS=$'\n\t'

name=$(basename "$0")

die() {
  printf '%s: %s\n' "$name" "$*" >&2
  exit 1
}

if ! command -v go >/dev/null 2>&1; then
  die 'go is required to build ai-sandbox but was not found on PATH'
fi

repo_root=$(cd "$(dirname "$0")/.." && pwd) || die 'could not resolve repository root'
cd "$repo_root" || die "could not cd to $repo_root"

install_dir="${AI_SANDBOX_INSTALL_DIR:-$HOME/.local/libexec/ai-sandboxes}"
install_path="$install_dir/ai-sandbox"
# Every use of $install_dir below is quoted, so spaces are fine, but a
# newline in the path would break the mktemp template and the mv target.
# Reject that explicitly rather than corrupting the install location.
case $install_dir in
  *$'\n'*) die 'AI_SANDBOX_INSTALL_DIR must not contain a newline' ;;
esac

mkdir -p "$install_dir" || die "could not create install directory $install_dir"

# The Fish wrappers only route `codex`/`claude` (agent-launch pass-throughs).
# Auth subcommands like `ai-sandbox codex mcp login` are typed by the user
# and need $PATH resolution to work. Symlink from ~/.local/bin (the usual
# per-user PATH prefix) into the trusted libexec install so the binary is
# reachable without exposing $install_dir itself on PATH.
symlink_dir="${AI_SANDBOX_BIN_DIR:-$HOME/.local/bin}"
symlink_path="$symlink_dir/ai-sandbox"
case $symlink_dir in
  *$'\n'*) die 'AI_SANDBOX_BIN_DIR must not contain a newline' ;;
esac

# Preflight the symlink target before touching the authoritative libexec
# binary below. `ln -sfn` unlinks whatever is already at $symlink_path, so
# without this check a pre-existing regular file or directory the user
# placed there (or a symlink pointing somewhere else entirely) would be
# silently destroyed. Failing here, before the build+swap, also means a
# conflict is reported as a clean no-op: the previous install is left fully
# intact rather than replaced with no working PATH entrypoint.
if [ -e "$symlink_dir" ] && [ ! -d "$symlink_dir" ]; then
  die "$symlink_dir exists and is not a directory; refusing to create the ai-sandbox symlink there"
fi
if { [ -e "$symlink_path" ] || [ -L "$symlink_path" ]; } && [ ! -L "$symlink_path" ]; then
  die "$symlink_path already exists and is not a symlink; remove it or set AI_SANDBOX_BIN_DIR to a different directory"
fi

# The temporary binary must live on the same filesystem as $install_path so the
# final `mv` is a rename (atomic swap). /tmp is often a separate filesystem, so
# stage inside $install_dir itself.
tmpdir=$(mktemp -d "$install_dir/.install.XXXXXX") || die 'could not create a staging directory inside install dir'
trap 'rm -rf -- "$tmpdir"' EXIT
tmp_bin="$tmpdir/ai-sandbox"

printf 'building ai-sandbox...\n'
go build -o "$tmp_bin" ./cmd/ai-sandbox || die 'go build ./cmd/ai-sandbox failed'

# Validate the freshly built binary before atomically swapping it in. If the
# binary is corrupt or was built against a broken tree we want the existing
# install to keep working.
built_version=$("$tmp_bin" version 2>/dev/null) || die 'built binary failed to report its version'
case "$built_version" in
  ai-sandbox\ *) ;;
  *) die "built binary produced unexpected version output: $built_version" ;;
esac

chmod 0755 "$tmp_bin" || die 'could not set mode on built binary'
mv -f "$tmp_bin" "$install_path" || die "could not install to $install_path"

mkdir -p "$symlink_dir" || die "could not create $symlink_dir"
ln -sfn "$install_path" "$symlink_path" || die "could not symlink $symlink_path -> $install_path"

printf 'installed %s (%s)\n' "$install_path" "$built_version"
printf 'symlinked %s -> %s\n' "$symlink_path" "$install_path"
case ":$PATH:" in
  *":$symlink_dir:"*) ;;
  *) printf 'note: %s is not on your PATH; add it or invoke ai-sandbox by absolute path\n' "$symlink_dir" >&2 ;;
esac
