#!/usr/bin/env bash
set -euo pipefail

script_dir="$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)"
# shellcheck disable=SC1091 # Resolved from this script's directory above.
source "$script_dir/prepare-upstream"

profile_require_command docker
trap profile_cleanup_upstream EXIT INT TERM
profile_prepare_upstream

cd "$PROFILE_UPSTREAM_WORKSPACE"
./scripts/build
./scripts/verify
