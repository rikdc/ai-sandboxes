#!/usr/bin/env bash
# Immutable release-marker CLI for agent runtime versions.
# Exit contract: 0 changed/valid, 1 unchanged/invalid, 2 error, 64 usage.
set -o pipefail
IFS=$'\n\t'

version_pattern='^[A-Za-z0-9][A-Za-z0-9._-]*$'
commit_pattern='^[0-9a-f]{40}$'
timestamp_pattern='^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$'

usage() {
  cat >&2 <<'EOF'
usage:
  release-marker changed OLD_VERSIONS_ENV NEW_VERSIONS_ENV
  release-marker create OUTPUT COMMIT BASE_VERSION CODEX_VERSION CLAUDE_CODE_VERSION CREATED_AT
  release-marker validate FILE COMMIT BASE_VERSION CODEX_VERSION CLAUDE_CODE_VERSION
EOF
  exit 64
}

valid_version() {
  [[ "$1" =~ $version_pattern ]] && [[ "$1" != *..* ]]
}

read_version() {
  local file=$1 key=$2 line value='' matches=0
  local prefix="${key}="
  test -r "$file" || {
    printf '%s\n' "error: cannot read $file" >&2
    return 2
  }
  while IFS= read -r line || test -n "$line"; do
    if [[ "$line" == "$prefix"* ]]; then
      value=${line#"$prefix"}
      ((matches += 1))
    fi
  done <"$file"
  test "$matches" = 1 || {
    printf '%s\n' "error: $file must contain exactly one $key assignment" >&2
    return 2
  }
  valid_version "$value" || {
    printf '%s\n' "error: invalid $key value in $file" >&2
    return 2
  }
  printf '%s\n' "$value"
}

validate_inputs() {
  local commit=$1 base_version=$2 codex_version=$3 claude_version=$4
  [[ "$commit" =~ $commit_pattern ]] || {
    printf '%s\n' 'error: commit must be a lowercase, 40-character SHA' >&2
    return 1
  }
  for version in "$base_version" "$codex_version" "$claude_version"; do
    valid_version "$version" || {
      printf '%s\n' 'error: version contains unsupported tag characters' >&2
      return 1
    }
  done
}

main() {
  case "${1:-}" in
    changed)
      # A release must be cut when any tracked version moves: a BASE_VERSION
      # bump is a control-plane release, an agent-version bump rides the
      # current binary along. Only when all three are unchanged is there
      # nothing to publish.
      test "$#" = 3 || usage
      old_base=$(read_version "$2" BASE_VERSION) || return 2
      old_codex=$(read_version "$2" CODEX_VERSION) || return 2
      old_claude=$(read_version "$2" CLAUDE_CODE_VERSION) || return 2
      new_base=$(read_version "$3" BASE_VERSION) || return 2
      new_codex=$(read_version "$3" CODEX_VERSION) || return 2
      new_claude=$(read_version "$3" CLAUDE_CODE_VERSION) || return 2
      if [[ "$old_base" != "$new_base" ]] ||
        [[ "$old_codex" != "$new_codex" ]] ||
        [[ "$old_claude" != "$new_claude" ]]; then
        return 0
      fi
      return 1
      ;;
    create)
      test "$#" = 7 || usage
      output=$2
      validate_inputs "$3" "$4" "$5" "$6" || return 1
      if ! [[ "$7" =~ $timestamp_pattern ]] ||
        ! jq --null-input --arg created_at "$7" \
          '($created_at | fromdateiso8601 != null)' >/dev/null; then
        printf '%s\n' 'error: created_at must be an RFC 3339 UTC timestamp' >&2
        return 1
      fi
      jq --null-input \
        --arg commit "$3" \
        --arg base "$4" \
        --arg codex "$5" \
        --arg claude "$6" \
        --arg created_at "$7" \
        '{schema_version: 2,
          upstream_commit: $commit,
          base_version: $base,
          codex_version: $codex,
          claude_code_version: $claude,
          created_at: $created_at}' >"$output" || return 1
      ;;
    validate)
      test "$#" = 6 || usage
      validate_inputs "$3" "$4" "$5" "$6" || return 1
      jq --exit-status \
        --arg commit "$3" \
        --arg base "$4" \
        --arg codex "$5" \
        --arg claude "$6" \
        'type == "object" and
         (keys | sort) == [
           "base_version", "claude_code_version", "codex_version",
           "created_at", "schema_version", "upstream_commit"] and
         .schema_version == 2 and
         .upstream_commit == $commit and
         .base_version == $base and
         .codex_version == $codex and
         .claude_code_version == $claude and
         (.created_at | type == "string" and
          test("^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$") and
          (fromdateiso8601 != null))' "$2" >/dev/null || return 1
      ;;
    *) usage ;;
  esac
}

main "$@"
