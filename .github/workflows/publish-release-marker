#!/usr/bin/env bash
# Publish the immutable agent-runtime release marker, or verify an existing
# one idempotently: re-publishing the same tag/commit succeeds as a no-op
# after validating the published marker.
set -o pipefail
IFS=$'\n\t'

repository=${GITHUB_REPOSITORY:?GITHUB_REPOSITORY is required}

cd "$(dirname "$0")/../.." || {
  printf '%s\n' 'error: failed to cd to repository root' >&2
  exit 1
}

usage() {
  cat >&2 <<'EOF'
usage:
  publish-release-marker COMMIT
EOF
  exit 64
}

test "$#" = 1 || usage
commit=$1

# shellcheck disable=SC1091 # Resolved from the repository root above.
source ./versions.env || {
  printf '%s\n' 'error: failed to source versions.env' >&2
  exit 1
}

marker_dir=$(mktemp -d) || exit 1
download_dir=$(mktemp -d) || exit 1
trap 'rm -rf -- "$marker_dir" "$download_dir"' EXIT
marker="$marker_dir/release.json"

# One linear tag lineage: agent-version bumps publish as a build-metadata
# suffix on the current project release line (BASE_VERSION), not as a
# separate tag namespace. A prerelease base (e.g. 0.1.0-alpha) keeps these
# releases out of GitHub's "Latest" slot automatically, the same as any
# other prerelease — no separate --latest handling needed here.
tag="v${BASE_VERSION}+codex-${CODEX_VERSION}-claude-${CLAUDE_CODE_VERSION}"
timestamp=$(date --utc +%Y-%m-%dT%H:%M:%SZ) || {
  printf '%s\n' 'error: could not compute release timestamp' >&2
  exit 1
}
prerelease_args=()
case $BASE_VERSION in
  *-*) prerelease_args=(--prerelease) ;;
esac

# Optional release assets beyond the marker (e.g. the darwin/arm64 control-
# plane binary tarball built by scripts/build-release). Whitespace-separated;
# paths containing whitespace are not supported.
asset_args=()
while IFS= read -r line; do
  [ -n "$line" ] || continue
  asset_args+=("$line")
done <<EOF
$(printf '%s' "${RELEASE_ASSETS:-}" | tr ' \t' '\n')
EOF

.github/workflows/release-marker create "$marker" "$commit" \
  "$BASE_VERSION" "$CODEX_VERSION" "$CLAUDE_CODE_VERSION" "$timestamp" || {
  printf '%s\n' 'error: failed to create release marker' >&2
  exit 1
}

if gh release view "$tag" --repo "$repository" >/dev/null 2>&1; then
  release_commit=$(gh release view "$tag" --repo "$repository" \
    --json targetCommitish --jq .targetCommitish) || exit 1
  test "$release_commit" = "$commit" || {
    printf '%s\n' "error: existing release points to $release_commit, expected $commit" >&2
    exit 1
  }
  gh release download "$tag" --repo "$repository" \
    --pattern release.json --dir "$download_dir" || exit 1
  .github/workflows/release-marker validate "$download_dir/release.json" \
    "$commit" "$BASE_VERSION" "$CODEX_VERSION" "$CLAUDE_CODE_VERSION" || exit 1
  # An interrupted publication (release created, assets never attached) must
  # not validate as complete: every configured asset has to be present.
  if [ "${#asset_args[@]}" -gt 0 ]; then
    published_assets=$(gh release view "$tag" --repo "$repository" \
      --json assets --jq '.assets[].name') || exit 1
    for asset in "${asset_args[@]}"; do
      grep -Fxq "$(basename "$asset")" <<<"$published_assets" || {
        printf '%s\n' "error: existing release is missing asset $(basename "$asset"); delete the release and re-run to republish" >&2
        exit 1
      }
    done
  fi
  exit 0
fi

if gh api "repos/$repository/git/ref/tags/$tag" >/dev/null 2>&1; then
  printf '%s\n' "error: tag already exists without a release: $tag" >&2
  exit 1
fi

for asset in "${asset_args[@]:-}"; do
  [ -n "$asset" ] || continue
  if [ ! -f "$asset" ]; then
    printf '%s\n' "error: release asset does not exist: $asset" >&2
    exit 1
  fi
done

gh release create "$tag" --repo "$repository" --target "$commit" \
  --title "v${BASE_VERSION} — Codex ${CODEX_VERSION}, Claude Code ${CLAUDE_CODE_VERSION}" \
  --notes "Machine-readable agent runtime release marker for v${BASE_VERSION} at ${commit}." \
  "${prerelease_args[@]}" \
  "$marker" \
  ${asset_args[@]+"${asset_args[@]}"} || {
  printf '%s\n' 'error: failed to publish release marker' >&2
  exit 1
}