#!/usr/bin/env bash
# Watch Codex and Claude Code npm releases, update versions.env, and expose the
# discovered versions for the create-pull-request action step to build a PR.
set -o pipefail
IFS=$'\n\t'

version_pattern='^[A-Za-z0-9][A-Za-z0-9._-]*$'

cd "$(dirname "$0")/../.." || {
  printf '%s\n' 'error: failed to cd to repository root' >&2
  exit 1
}

read_env_value() {
  local key=$1 value='' line
  while IFS= read -r line; do
    [[ "$line" == "$key="* ]] && value=${line#"$key="}
  done <versions.env
  printf '%s\n' "$value"
}

version_le() {
  # 0 if $1 sorts at or below $2 (GNU version sort; Ubuntu runners).
  test "$(printf '%s\n%s\n' "$1" "$2" | sort -V | head -n 1)" = "$1"
}

latest_version() {
  local package=$1 version
  version=$(curl --fail --location --silent --show-error --retry 3 \
    "https://registry.npmjs.org/${package}/latest" |
    jq --raw-output --exit-status .version) || {
    printf '%s\n' "error: could not fetch latest $package version" >&2
    return 1
  }
  [[ "$version" =~ $version_pattern && "$version" != *..* ]] || {
    printf '%s\n' "error: invalid discovered version for $package: $version" >&2
    return 1
  }
  printf '%s\n' "$version"
}

codex_version=$(latest_version '@openai%2Fcodex') || exit 1
claude_version=$(latest_version '@anthropic-ai%2Fclaude-code') || exit 1

existing_codex=$(read_env_value CODEX_VERSION)
existing_claude=$(read_env_value CLAUDE_CODE_VERSION)

if [[ "$existing_codex" = "$codex_version" ]] &&
  [[ "$existing_claude" = "$claude_version" ]]; then
  printf '%s\n' 'Agent runtime versions are current.'
  exit 0
fi

if [[ -n "$existing_codex" ]] &&
  [[ "$existing_codex" != "$codex_version" ]] &&
  version_le "$codex_version" "$existing_codex"; then
  printf '%s\n' "error: refusing to downgrade Codex" \
    "($existing_codex -> $codex_version)" >&2
  exit 1
fi
if [[ -n "$existing_claude" ]] &&
  [[ "$existing_claude" != "$claude_version" ]] &&
  version_le "$claude_version" "$existing_claude"; then
  printf '%s\n' "error: refusing to downgrade Claude Code" \
    "($existing_claude -> $claude_version)" >&2
  exit 1
fi

grep -q '^CODEX_VERSION=' versions.env || {
  printf '%s\n' 'error: versions.env lacks a CODEX_VERSION assignment' >&2
  exit 1
}
grep -q '^CLAUDE_CODE_VERSION=' versions.env || {
  printf '%s\n' 'error: versions.env lacks a CLAUDE_CODE_VERSION assignment' >&2
  exit 1
}

sed -i.bak "s/^CODEX_VERSION=.*/CODEX_VERSION=$codex_version/" versions.env
sed -i.bak \
  "s/^CLAUDE_CODE_VERSION=.*/CLAUDE_CODE_VERSION=$claude_version/" versions.env
rm -f versions.env.bak

if test -n "${GITHUB_ENV:-}"; then
  {
    printf 'CODEX_VERSION=%s\n' "$codex_version"
    printf 'CLAUDE_CODE_VERSION=%s\n' "$claude_version"
  } >>"$GITHUB_ENV"
fi

body_file=$(mktemp)
{
  if [[ "$existing_codex" != "$codex_version" ]]; then
    printf 'Updates Codex to %s.\n' "$codex_version"
  fi
  if [[ "$existing_claude" != "$claude_version" ]]; then
    printf 'Updates Claude Code to %s.\n' "$claude_version"
  fi
  printf '%s\n' \
    'Merging this pull request runs ARM64 verification and publishes the immutable release marker.'
} >"$body_file"
printf 'PR_BODY_PATH=%s\n' "$body_file" >>"$GITHUB_ENV"
